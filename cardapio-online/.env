# Versão do PHP (opcional)
PHP_VERSION=8.2

# Portas (opcional)
NGINX_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
PHPMYADMIN_HOST_PORT=8080
MYSQL_HOST_PORT=3306