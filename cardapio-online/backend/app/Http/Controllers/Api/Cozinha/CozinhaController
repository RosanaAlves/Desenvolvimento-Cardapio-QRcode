<?php
namespace App\Http\Controllers\Api\Cozinha;

use App\Http\Controllers\Controller;
use App\Models\Pedido;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Log;

class PedidoController extends Controller
{
    /**
     * Pedidos para cozinha - APENAS pendentes/preparando
     */
    public function index()
    {
        try {
            $pedidos = Pedido::with(['itens.produto', 'mesa'])
                            ->whereIn('status', ['pendente', 'preparando'])
                            ->orderBy('created_at', 'asc')
                            ->get()
                            ->map(function($pedido) {
                                return [
                                    'id' => $pedido->id,
                                    'mesa_numero' => $pedido->mesa->numero,
                                    'cliente_nome' => $pedido->cliente_nome,
                                    'status' => $pedido->status,
                                    'status_formatado' => $pedido->status_formatado,
                                    'created_at' => $pedido->created_at->format('H:i'),
                                    'tempo_espera' => $pedido->tempo_espera,
                                    'itens' => $pedido->itens->map(function($item) {
                                        return [
                                            'produto_nome' => $item->produto->nome,
                                            'quantidade' => $item->quantidade,
                                            'observacoes' => $item->observacoes
                                        ];
                                    })
                                ];
                            });

            return $this->success($pedidos);

        } catch (\Exception $e) {
            Log::error('Erro Cozinha/PedidoController: ' . $e->getMessage());
            return $this->error('Erro ao carregar pedidos', 500);
        }
    }

    /**
     * Atualizar status - APENAS cozinha
     */
    public function atualizarStatus(Request $request, $id)
    {
        try {
            $validated = $request->validate([
                'status' => 'required|in:preparando,pronto'
            ]);

            $pedido = Pedido::find($id);
            
            if (!$pedido) {
                return $this->error('Pedido não encontrado', 404);
            }

            if ($validated['status'] === 'preparando') {
                $pedido->marcarComoPreparando();
            } else {
                $pedido->marcarComoPronto();
            }

            return $this->success($pedido, 'Status atualizado com sucesso');

        } catch (\Exception $e) {
            Log::error('Erro ao atualizar status (cozinha): ' . $e->getMessage());
            return $this->error('Erro ao atualizar status', 500);
        }
    }
}